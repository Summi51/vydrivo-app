# Copy to .env.local. Never commit real values.
# This portfolio copy does not include the private generation services.

APP_URL=http://127.0.0.1:3000

# Auth. Leave blank for a UI-only local run.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=false

# Public sample media origin. Empty uses local files when they are present.
NEXT_PUBLIC_MEDIA_BASE_URL=
